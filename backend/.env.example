# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (runtime). En Neon usa la URL "pooled" (host con -pooler).
DATABASE_URL="postgresql://postgres:1234@localhost:5432/legendaryclass?schema=public"
# Conexión directa para migraciones (sin pooler). En local es igual a DATABASE_URL;
# en Neon usa la URL directa (host sin -pooler).
DIRECT_URL="postgresql://postgres:1234@localhost:5432/legendaryclass?schema=public"

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET="replace_with_a_strong_random_secret_min_32_chars"
JWT_EXPIRES_IN="7d"

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Frontend URL (CORS) ──────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:4200"
